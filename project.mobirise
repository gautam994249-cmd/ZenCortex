    "index.html": {
      "settings": {
        "main": true,
        "title": "ZenCortex is a natural hearing support supplement designed to promote auditory wellness and overall brain health. Its formula contains plant-based ingredients aimed at supporting healthy hearing, mental clarity, and focus. Easy-to-use daily drops make it simple to",
        "meta_descr": "ZenCortex is a natural hearing support supplement made to help maintain healthy hearing and auditory wellness. Its carefully selected ingredients aim to support brain health, mental clarity, and focus. The easy-to-use liquid formula fits conveniently into your daily routine. ZenCortex is ideal for adults looking for natural wellness support. Individual experiences may vary depend",
        "header_custom": "<meta name=\"keywords\" content=\"prosta defend, prostadefend, prosta defend supplement, prosta defend pills\">\n <meta name=\"author\" content=\"prosta defend\">\n\t\t\n <link rel=\"canonical\" href=\"\" >",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/how-to-use-zencortex.webp"
      },
      "components": [
        {
